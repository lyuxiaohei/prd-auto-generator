{
  "name": "素材选中状态",
  "description": "测试状态机设计的PRD生成，验证状态流转规则",
  "sourceCode": {
    "type": "javascript",
    "stateField": "selectedMaterialIds",
    "stateType": "array",
    "transitions": [
      {
        "trigger": "toggleMaterial(id)",
        "action": "add/remove from array",
        "description": "点击素材卡片切换选中状态"
      },
      {
        "trigger": "handleSelectAll()",
        "action": "add all filtered ids",
        "description": "点击全选选中当前筛选结果"
      },
      {
        "trigger": "switchTab()",
        "action": "clear array",
        "description": "切换标签页清空选中"
      },
      {
        "trigger": "selectCategory()",
        "action": "clear array",
        "description": "切换分类清空选中"
      },
      {
        "trigger": "deleteMaterial()",
        "action": "remove from array",
        "description": "删除素材后从选中列表移除"
      }
    ]
  },
  "featureOutline": {
    "moduleName": "素材选择",
    "features": [
      {
        "name": "素材选择",
        "type": "interaction",
        "states": ["未选中", "已选中"]
      }
    ]
  },
  "expectedOutput": {
    "requiredSections": [
      "1. 功能概述",
      "3. 业务逻辑",
      "3.3 状态机设计"
    ],
    "stateMachine": {
      "states": [
        {"code": "unselected", "name": "未选中", "description": "初始状态，素材未选中"},
        {"code": "selected", "name": "已选中", "description": "素材已被选中，显示选中标识"}
      ],
      "transitions": [
        {"from": "未选中", "to": "已选中", "trigger": "点击素材卡片"},
        {"from": "已选中", "to": "未选中", "trigger": "再次点击取消"},
        {"from": "已选中", "to": "未选中", "trigger": "切换分类"},
        {"from": "已选中", "to": "未选中", "trigger": "切换标签页"}
      ],
      "uiDifferences": [
        {"state": "已选中", "ui": "卡片显示选中框、背景色变化、勾选图标"}
      ]
    },
    "diagramType": "stateDiagram-v2",
    "diagramElements": [
      "[*] --> 未选中",
      "未选中 --> 已选中: 点击素材卡片",
      "已选中 --> 未选中: 再次点击取消",
      "已选中 --> 未选中: 切换分类",
      "已选中 --> 未选中: 切换标签页"
    ]
  }
}